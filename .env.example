# ─── App ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
# Background auto-pay jobs. Set to false to run the API without the
# scheduler paying bills (the scheduler still starts, its jobs no-op).
SCHEDULER_ENABLED=true

# ─── Database ───────────────────────────────────────────────────────
# These three are used by docker-compose.yml to provision the Postgres container.
POSTGRES_USER=postgres
# Change this. docker-compose refuses to start without it.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autopay
POSTGRES_PORT=5432

# DATABASE_URL is what the application connects to. It is constructed by
# docker-compose from the values above. For local runs (uvicorn outside
# Docker), point it at your own PostgreSQL:
#
#   Option A — a local PostgreSQL on this machine:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/autopay
#
#   Option B — the Docker postgres service (run `make up` first);
#              inside the compose network the host is `db`:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db:5432/autopay
#
#   Option C — a different superuser/password you have on this machine:
#   DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/autopay
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/autopay

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ─── Paystack ───────────────────────────────────────────────────────
# From https://dashboard.paystack.com/#/settings/developer
# Use the test keys (sk_test_...) while developing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Telegram ───────────────────────────────────────────────────────
# Get from @BotFather. Leaving this empty disables the bot.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the leading @. Used in deep-link URLs
# (https://t.me/<username>?start=<code>). Optional.
TELEGRAM_BOT_USERNAME=
# Secret token Telegram echoes back on every webhook request. Required
# in production when webhook mode is on. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
TELEGRAM_SECRET_TOKEN=
# Production: Telegram pushes to this URL. Empty = polling mode (dev only).
# Should end in /telegram/webhook (the route mounted by app.main).
WEBHOOK_URL=

# ─── LLM ────────────────────────────────────────────────────────────
# Enables LLM bill extraction. Empty means the OCR + regex fallbacks.
GROQ_API_KEY=
GOOGLE_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false

# ─── Fees ───────────────────────────────────────────────────────────
PAYOUT_FEE_NGN=50.00

# ─── Security ───────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BVN_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
